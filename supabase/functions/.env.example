# Configure em Supabase > Edge Functions > Secrets. Nunca no frontend.
APP_URL=https://seu-app.vercel.app
ASAAS_ENV=sandbox
ASAAS_API_KEY=configure-no-secret-store
ASAAS_WEBHOOK_TOKEN=gere-um-token-aleatorio-longo
# Uma conta Asaas autorizada para uma escola. Nunca compartilhe silenciosamente entre tenants.
ASAAS_SCHOOL_ID=uuid-da-escola
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY são fornecidos pelo runtime.
